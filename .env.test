# Test configuration - minimal setup
NODE_ENV=development
PORT=3001

# Database - would need real credentials
DB_SERVER=localhost
DB_DATABASE=TestDB
DB_USER=testuser
DB_PASSWORD=testpass
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Optional integrations - disabled for testing
NATS_URL=
OPA_URL=
MAP_SERVICE_URL=

# Logging
LOG_LEVEL=error
METRICS_ENABLED=true
