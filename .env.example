# Application
NODE_ENV=development
PORT=3001

# Azure SQL Server Configuration
DB_SERVER=your-server.database.windows.net
DB_DATABASE=DeliveryServiceDB
DB_USER=your-username
DB_PASSWORD=your-password
DB_NAME=DeliveryServiceDB
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_PORT=1433
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=30000

# NATS Messaging Configuration (Cloud-first - no localhost defaults)
# Leave empty to disable NATS messaging
NATS_URL=
# Example (free demo): NATS_URL=nats://demo.nats.io:4222
NATS_CLIENT_NAME=delivery-service
NATS_MAX_RECONNECT_ATTEMPTS=10
NATS_RECONNECT_TIME_WAIT=2000
# Optional authentication
NATS_USER=
NATS_PASSWORD=
NATS_TOKEN=

# Event Subjects Configuration
# Defaults (sem prefixo)
DELIVERY_STATUS_SUBJECT=delivery.status.changed
DELIVERY_CREATED_SUBJECT=delivery.created
DELIVERY_COMPLETED_SUBJECT=delivery.completed
ORDER_CREATED_SUBJECT=
# Exemplos com prefixo (descomente se quiser usar)
# DELIVERY_STATUS_SUBJECT=delivery.iYoNuttxD.7f2a.delivery.status.changed
# DELIVERY_CREATED_SUBJECT=delivery.iYoNuttxD.7f2a.delivery.created
# DELIVERY_COMPLETED_SUBJECT=delivery.iYoNuttxD.7f2a.delivery.completed
# ORDER_CREATED_SUBJECT=delivery.iYoNuttxD.7f2a.order.created
# Additional subjects (comma-separated)
ADDITIONAL_SUBJECTS=

# OPA (Open Policy Agent) Configuration
# Leave empty to disable policy-based authorization
OPA_URL=
# Example (Worker): OPA_URL=https://your-opa-worker.workers.dev
OPA_POLICY_PATH=v1/data/delivery/authz/allow
OPA_TIMEOUT=5000
OPA_FAIL_OPEN=true

# Map Integration Configuration
# Leave empty to disable map integration
MAP_SERVICE_URL=
# Example (Worker + ORS): MAP_SERVICE_URL=https://your-map-worker.workers.dev
# If you prefer to send the ORS key from the app (optional):
MAP_API_KEY=
MAP_PROVIDER=ors
MAP_SERVICE_TIMEOUT=10000

# Metrics Configuration
METRICS_ENABLED=true

# Logging
LOG_LEVEL=info
