# Application
NODE_ENV=development
PORT=3001

# Azure SQL Server Configuration
DB_SERVER=your-server.database.windows.net
DB_DATABASE=DeliveryServiceDB
DB_USER=your-username
DB_PASSWORD=your-password

# Logging
LOG_LEVEL=info

# NATS Configuration (Event-Driven Architecture)
# Optional - if not set, service runs without EDA
NATS_URL=nats://localhost:4222
NATS_CLIENT_ID=delivery-service
NATS_SUBJECT_ORDER_CREATED=order.created

# OPA Configuration (Policy-based Authorization)
# Optional - if not set, OPA authorization is bypassed
OPA_URL=http://localhost:8181

# Maps API Configuration (Routes and ETA)
# Optional - if not set, mock values are returned
MAPS_API_URL=https://maps.googleapis.com/maps/api
MAPS_API_KEY=your-google-maps-api-key
